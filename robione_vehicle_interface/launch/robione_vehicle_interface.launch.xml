<?xml version="1.0"?>
<launch>
  <arg name="robione_vehicle_interface_param_path" default="$(find-pkg-share robione_vehicle_interface)/config/robione_vehicle_interface.param.yaml"/>
  <arg name="sick_output_paths_topic" default="/pointcloud_preprocessor/sick_safetyscanners2_node/output_paths"/>
  <arg name="external_velocity_limit_topic" default="/planning/scenario_planning/max_velocity_default"/>

  <!-- CAN Receiver -->
  <node pkg="robione_vehicle_interface" exec="robione_vehicle_interface_node" name="robione_vehicle_interface" output="both">
    <param from="$(var robione_vehicle_interface_param_path)"/>
    <remap from="~/input/sick/output_paths" to="$(var sick_output_paths_topic)"/>
    <remap from="~/output/velocity_limit" to="$(var external_velocity_limit_topic)"/>
  </node>

</launch>